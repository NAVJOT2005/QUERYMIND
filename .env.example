# ---------------------------------------------------------------------------
# Copy this file to `.env` (it is git-ignored) OR run `querymind keys set <provider>`
# which stores keys outside your repo entirely (~/.config/querymind/credentials.env).
#
# Lookup order for every key:  shell env  ->  ./.env  ->  ~/.config/querymind/credentials.env
# ---------------------------------------------------------------------------

# --- LLM providers (set at least one; free tiers work) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Ollama (local) needs no key.

# --- Database (or let `querymind init` write non-secret settings for you) ---
# Prefer a READ-ONLY database user.
QUERYMIND_DB_URL=mysql://qm_readonly:qm_readonly_pw@127.0.0.1:3307/shop
